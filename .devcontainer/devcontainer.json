{
  "name": "Claude Code Sandbox",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "TZ": "${localEnv:TZ:Europe/Berlin}",
      "CLAUDE_CODE_VERSION": "2.1.175",
      "BUN_VERSION": "1.2.0",
      "PLAYWRIGHT_VERSION": "1.60.0",
      "GIT_DELTA_VERSION": "0.18.2",
      "ZSH_IN_DOCKER_VERSION": "1.2.0"
    }
  },
  // NET_ADMIN/NET_RAW are the ONLY elevated capabilities — needed so
  // init-firewall.sh can program iptables. Nothing runs privileged.
  "runArgs": ["--cap-add=NET_ADMIN", "--cap-add=NET_RAW"],
  "remoteUser": "dev",
  "customizations": {
    "vscode": {
      // Editor integration is a free bonus, not a requirement (spec §3).
      "extensions": [
        "anthropic.claude-code",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "eamodio.gitlens"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "terminal.integrated.defaultProfile.linux": "zsh"
      }
    }
  },
  "containerEnv": {
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1", // no sentry/statsig egress
    "DISABLE_AUTOUPDATER": "1",
    "CLAUDE_CONFIG_DIR": "/home/dev/.claude",
    // Advertise 24-bit color for sessions that don't get it forwarded (e.g.
    // VS Code-launched, not via `bun run sandbox`). The wrapper forwards the
    // host's TERM/COLORTERM per-session, which overrides this when present.
    "COLORTERM": "truecolor"
  },
  // Forward the host's subscription token into the container when present.
  // Never hard-code it in containerEnv — this file is committed.
  "remoteEnv": {
    "CLAUDE_CODE_OAUTH_TOKEN": "${localEnv:CLAUDE_CODE_OAUTH_TOKEN}"
  },
  "mounts": [
    // Persist shell history + Claude auth/settings across rebuilds, per container.
    "source=claude-code-bashhistory-${devcontainerId},target=/commandhistory,type=volume",
    "source=claude-code-config-${devcontainerId},target=/home/dev/.claude,type=volume"
  ],
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=delegated",
  "workspaceFolder": "/workspace",
  // Program the egress firewall on every start; block until it (and its
  // fail-closed self-test) succeed.
  "postStartCommand": "sudo /usr/local/bin/init-firewall.sh",
  "waitFor": "postStartCommand"
}
